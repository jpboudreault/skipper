# Your Fly.io app name (used by deploy.sh — keeps your app name out of fly.toml)
FLY_APP_NAME=your-fly-app-name

# Required in production (generate with: openssl rand -hex 32)
JWT_SECRET=generate_a_secure_random_key_here

# Google OAuth 2.0 Web Client ID for Google Sign-In
# Create credentials at https://console.cloud.google.com
# Add http://localhost:5173 and your production URL to Authorized JavaScript Origins
GOOGLE_CLIENT_ID=your_google_client_id_here

# Microsoft OAuth Application (client) ID for Microsoft Sign-In
# Register at https://portal.azure.com → App registrations
# Add http://localhost:5173 and your production URL as SPA redirect URIs
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Set to true for local development (auto-creates users on first login)
DEV_MODE=true

# Optional: Anthropic Claude API Key for scoresheet photo ingestion
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: scoresheet OCR pipeline (default in code and on Fly: rows)
# SCORESHEET_PARSE_MODE=rows   # one crop per batter row (recommended)
# SCORESHEET_PARSE_MODE=legacy # single-pass with horizontal tiles
# SCORESHEET_PARSE_MODE=transcribe

# Optional: lock the app to a single language (en or fr). Hides the language picker
# and ignores browser/localStorage preferences. Omit for bilingual mode (default).
# SKIPPER_LOCALE=fr
